<local:MyPageRight
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Class="PageCommunity" PanScroll="PanBack"
             d:DesignWidth="800" d:DesignHeight="800">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Title="社区游戏" Margin="0,0,0,15">
                <StackPanel Margin="25,40,23,15">
                    <TextBlock TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource ColorBrush1}"
                               Text="这里展示栎木栎林社区的 Minecraft 服务器。状态来自服务器实时的 MOTD 查询，点击「刷新状态」可重新获取。" />
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Opacity="0.65"
                               Text="「一键加入」正在开发中：届时将自动准备所需客户端并直接进入服务器。" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnRefresh" Text="刷新状态" Height="35" Padding="20,0,20,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnCheckUpdate" Text="检查列表更新" Height="35" Margin="10,0,0,0" Padding="20,0,20,0"
                                        ToolTip="从社区托管地址同步最新服务器列表（新增、修改、删除）" />
                        <local:MyTextButton x:Name="BtnEditConfig" Text="编辑服务器列表" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="LabRefreshTime" Text="尚未查询" Margin="0,10,0,0" FontSize="11.5" Opacity="0.6" />
                    <TextBlock x:Name="LabSyncInfo" Text="正在读取列表状态……" Margin="0,4,0,0" FontSize="11" Opacity="0.5" FontStyle="Italic" />
                </StackPanel>
            </local:MyCard>
            <StackPanel x:Name="PanServers" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
