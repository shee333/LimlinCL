<local:MyPageRight
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d" x:Class="PageLinkMain" PanScroll="PanBack"
               d:DesignWidth="800" d:DesignHeight="800">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Title="联机房间" Margin="0,0,0,15">
                <StackPanel Margin="25,40,23,15">
                    <TextBlock TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource ColorBrush1}"
                               Text="和好友一起玩：房主创建房间后把邀请码发给好友，好友输入邀请码即可加入。联机使用无需安装驱动、无需管理员权限的虚拟网络。" />
                    <TextBlock x:Name="LabStatus" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12.5" Opacity="0.75" Text="尚未开始联机" />
                    <StackPanel x:Name="PanActions" Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnCreate" Text="创建房间" Height="35" Padding="20,0,20,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnCancel" Text="取消" Height="35" Margin="10,0,0,0" Padding="20,0,20,0" ColorType="Red" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock Text="或输入邀请码加入好友的房间：" Margin="0,16,0,0" FontSize="12.5" Opacity="0.75" />
                    <StackPanel x:Name="PanJoin" Orientation="Horizontal" Margin="0,8,0,0">
                        <local:MyTextBox x:Name="TxtInvite" Width="330" Height="35" HintText="粘贴邀请码，例如 L/1A2B-3C4D-5E6F-7G8H" VerticalContentAlignment="Center" />
                        <local:MyButton x:Name="BtnJoin" Text="加入房间" Height="35" Margin="10,0,0,0" Padding="20,0,20,0" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardRoom" Title="房间信息" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="25,40,23,15">
                    <TextBlock x:Name="LabRoomTitle" Text="把下面的邀请码发给好友：" FontSize="12.5" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock x:Name="LabInvite" Margin="0,8,0,0" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="LabRoomInfo" Margin="0,8,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnCopyInvite" Text="复制邀请码" Height="35" Padding="20,0,20,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnStop" Text="关闭房间" Height="35" Margin="10,0,0,0" Padding="20,0,20,0" ColorType="Red" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="怎么用" Margin="0,0,0,15">
                <StackPanel Margin="25,40,23,15">
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Opacity="0.78" LineHeight="20"
                               Text="1. 房主：进入单人世界 → 按 Esc → 点「对局域网开放」→ 回到本页点「创建房间」&#10;2. 房主：把生成的邀请码发给好友（也可以直接复制）&#10;3. 好友：点「加入房间」，粘贴邀请码，点「加入」&#10;4. 加入成功后，在「多人游戏 → 局域网世界」里会出现房间，点击进入即可&#10;5. 首次联机需要下载 EasyTier 组件（约 20 MB），请耐心等待" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>